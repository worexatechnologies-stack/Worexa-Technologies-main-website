# .htaccess for PHP and SPA routing
# - Disables directory listing
# - Ensures PHP files are handled
# - Canonical redirects (HTTPS, non-www, and old domain worexa.in)
# - Provides a fallback to index.html for frontend routes (preserves existing files like .php, .xml, .txt)

Options -Indexes

# Prefer index.php, then index.html
DirectoryIndex index.php index.html

<IfModule mod_mime.c>
  # Ensure .php files are handled by PHP
  AddHandler application/x-httpd-php .php
  AddType application/xml .xml
  AddCharset UTF-8 .xml
  AddType text/plain .txt
  AddCharset UTF-8 .txt
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Canonical Redirect: Old domain (worexa.in / www.worexa.in) to worexatechnologies.com
  RewriteCond %{HTTP_HOST} ^(www\.)?worexa\.in$ [NC]
  RewriteRule ^(.*)$ https://worexatechnologies.com/$1 [R=301,L]

  # 2. Canonical Redirect: www to non-www
  RewriteCond %{HTTP_HOST} ^www\.worexatechnologies\.com$ [NC]
  RewriteRule ^(.*)$ https://worexatechnologies.com/$1 [R=301,L]

  # 3. Canonical Redirect: Force HTTPS (avoids loop when behind reverse proxy/CDN)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://worexatechnologies.com/$1 [R=301,L]

  # 4. Allow direct static access to sitemaps and robots.txt without rewriting
  RewriteRule ^(sitemap.*\.xml|blogs\.xml|robots\.txt)$ - [L]

  # 5. Block access to hidden files and directories (like .git, .env)
  RewriteRule "(^|/)\.(?!well-known)" - [F]

  # 6. Block direct access to smtp-config
  RewriteRule "(^|/)smtp-config.*\.php$" - [F]

  # 7. Serve landing subdirectories without trailing slash
  RewriteRule ^best-marketing-company-in-bangalore/?$ best-marketing-company-in-bangalore/index.html [L]
  RewriteRule ^best-application-development-in-bangalore/?$ best-application-development-in-bangalore/index.html [L]

  # 8. If the request matches an existing file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 9. Otherwise, route to the SPA entry (index.html)
  RewriteRule ^ index.html [L]
</IfModule>

# Gzip / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff application/font-woff2
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Security and Cache headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

  # Static assets immutable caching
  <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg|js|css|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # HTML revalidate
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
  </FilesMatch>

  # XML sitemaps and robots headers
  <FilesMatch "\.xml$">
    Header set Content-Type "application/xml; charset=UTF-8"
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set X-Robots-Tag "all"
  </FilesMatch>
  <FilesMatch "robots\.txt$">
    Header set Content-Type "text/plain; charset=UTF-8"
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set X-Robots-Tag "all"
  </FilesMatch>
</IfModule>

# Explicitly grant access to public XML sitemaps and robots.txt
<FilesMatch "^(sitemap.*\.xml|blogs\.xml|robots\.txt)$">
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
  </IfModule>
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</FilesMatch>

# Prevent access to sensitive files, logs, configs, and source maps
<FilesMatch "(^\.env.*|smtp-config.*\.php|composer\.(json|lock)|package(-lock)?\.json|vercel\.json|BACKEND_SETUP\.md|.*\.(log|bak|backup|old|sql|sh|md))$">
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
